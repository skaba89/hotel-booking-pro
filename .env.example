# ============================================
# Hotel Booking Pro - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking_pro?schema=public"

# ---- Redis (optional) ----
REDIS_URL="redis://localhost:6379"

# ---- Backend API ----
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development

# ---- JWT Auth ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- PayPal ----
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"

# ---- Mobile Money Webhook ----
MOBILE_MONEY_WEBHOOK_SECRET="your-mobile-money-webhook-secret"

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="Hotel SETIFANA <noreply@setifana.com>"

# ---- Hotel Info ----
HOTEL_NAME="Hotel SETIFANA"
HOTEL_EMAIL="contact@setifana.com"
HOTEL_PHONE="+224 XXX XXX XXX"
HOTEL_WHATSAPP="+224 XXX XXX XXX"
HOTEL_ADDRESS="Conakry, Guinée"
HOTEL_CURRENCY="GNF"
HOTEL_TAX_RATE="18"

# ---- Google Maps ----
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# ---- Upload ----
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
