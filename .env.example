# ============================================
# Hotel Booking Pro - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Database ----
# DATABASE_URL     → pooler URL in production (Neon: use the "-pooler" endpoint + ?pgbouncer=true)
#                    direct URL in local dev (no pooler needed locally)
# DIRECT_DATABASE_URL → always the direct (non-pooler) connection.
#                       Used by Prisma CLI for migrations; same as DATABASE_URL in local dev.
#                       In production on Neon: omit ?pgbouncer=true and use the direct host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking_pro?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking_pro?schema=public"

# ---- Redis (optional) ----
REDIS_URL="redis://localhost:6379"

# ---- Backend API ----
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development

# ---- JWT Auth ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- PayPal ----
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"

# ---- Mobile Money Webhook ----
MOBILE_MONEY_WEBHOOK_SECRET="your-mobile-money-webhook-secret"

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="Hotel SETIFANA <noreply@setifana.com>"

# ---- Hotel Info ----
HOTEL_NAME="Hotel SETIFANA"
HOTEL_EMAIL="contact@setifana.com"
HOTEL_PHONE="+224 XXX XXX XXX"
HOTEL_WHATSAPP="+224 XXX XXX XXX"
HOTEL_ADDRESS="Conakry, Guinée"
HOTEL_CURRENCY="GNF"
HOTEL_TAX_RATE="18"

# ---- Chatbot AI (multi-provider, all optional) ----
# Set one or more keys. The chatbot tries providers in AI_PROVIDER_ORDER and
# falls back to the next one on failure, then to the built-in static FAQ when
# none are configured/available. Leave all unset to keep the FAQ-only chatbot.
# Optional ordered preference (comma-separated ids):
#   groq, gemini, glm, github, openai, claude, qwen, openrouter
AI_PROVIDER_ORDER="groq,gemini,glm,github,openai,claude,qwen,openrouter"
# Each provider: API key (required to enable) + optional model override.
GLM_API_KEY=""            # open.bigmodel.cn  (default model: glm-4-flash)
GLM_MODEL=""
OPENAI_API_KEY=""         # api.openai.com    (default model: gpt-4o-mini)
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""      # api.anthropic.com (default model: claude-3-5-haiku-latest)
ANTHROPIC_MODEL=""
GEMINI_API_KEY=""         # Google AI Studio  (default model: gemini-1.5-flash)
GEMINI_MODEL=""
GROQ_API_KEY=""           # api.groq.com      (default model: llama-3.3-70b-versatile)
GROQ_MODEL=""
QWEN_API_KEY=""           # DashScope intl    (default model: qwen-plus)
QWEN_MODEL=""
OPENROUTER_API_KEY=""     # openrouter.ai     (default model: meta-llama/llama-3.1-8b-instruct)
OPENROUTER_MODEL=""
GITHUB_MODELS_TOKEN=""    # GitHub Models     (GitHub PAT with "models" perm; default model: gpt-4o-mini)
GITHUB_MODELS_MODEL=""

# ---- Google Maps ----
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# ---- Upload ----
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
