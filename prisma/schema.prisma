generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url       = the pooler connection (PgBouncer) used by Prisma at runtime.
  // directUrl = bypasses the pooler and goes direct — required for migrations.
  //
  // Neon setup (Render env vars):
  //   DATABASE_URL     = postgres://...@ep-xxx-pooler.region.aws.neon.tech/dbname?pgbouncer=true
  //   DIRECT_DATABASE_URL = postgres://...@ep-xxx.region.aws.neon.tech/dbname
  //
  // Local dev: set both to the same direct connection string (no pooler needed).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PAY_AT_HOTEL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  ORANGE_MONEY
  MTN_MONEY
  WAVE
  PAY_AT_HOTEL
}

enum TransactionStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum ContactStatus {
  NEW
  READ
  ANSWERED
  ARCHIVED
}

enum StaffDepartment {
  HOUSEKEEPING
  RECEPTION
  RESTAURANT
  KITCHEN
  MAINTENANCE
  SECURITY
  MANAGEMENT
  OTHER
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  ABSENT
  CANCELLED
}

enum DocumentType {
  QUOTE
  INVOICE
}

// Statuts couvrant devis ET factures. Les transitions valides dépendent du
// type et sont contrôlées côté service (document-status.ts).
// Devis  : DRAFT -> SENT -> ACCEPTED | REJECTED | EXPIRED
// Facture: DRAFT -> SENT -> PAID | CANCELLED
enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  PAID
  CANCELLED
}

// Catégories de dépenses de l'hôtel (liste figée, pilotée côté UI).
enum ExpenseCategory {
  SUPPLIES // Fournitures
  SALARIES // Salaires
  UTILITIES // Énergie / Eau
  MAINTENANCE // Maintenance
  MARKETING // Marketing
  FOOD_BEVERAGE // Nourriture & Boissons
  RENT // Loyer
  TAXES // Taxes
  OTHER // Autre
}

// Moyens de paiement d'une dépense.
enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHECK
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer      Customer?
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  // id = le "jti" embarque dans le refresh token JWT. Une ligne presente et
  // non expiree => token valide. Rotation: la ligne est supprimee a l'usage et
  // une nouvelle est creee. Logout: la ligne est supprimee. Les anciens tokens
  // emis avant ce systeme n'ont pas de ligne => rejetes (reconnexion unique).
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique @map("user_id")
  fullName  String   @map("full_name")
  email     String
  phone     String?
  country   String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

model Room {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  description      String?    @db.Text
  shortDescription String?    @map("short_description")
  pricePerNight    Decimal    @map("price_per_night") @db.Decimal(12, 2)
  capacity         Int        @default(2)
  adultsCapacity   Int        @default(2) @map("adults_capacity")
  childrenCapacity Int        @default(1) @map("children_capacity")
  bedType          String?    @map("bed_type")
  sizeM2           Decimal?   @map("size_m2") @db.Decimal(6, 1)
  amenities        Json       @default("[]")
  status           RoomStatus @default(AVAILABLE)
  isFeatured       Boolean    @default(false) @map("is_featured")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  images             RoomImage[]
  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]
  priceRules         PriceRule[]

  @@map("rooms")
}

model RoomImage {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_images")
}

model Booking {
  id                 String        @id @default(cuid())
  bookingReference   String        @unique @map("booking_reference")
  customerId         String        @map("customer_id")
  roomId             String        @map("room_id")
  customerName       String        @map("customer_name")
  customerEmail      String        @map("customer_email")
  customerPhone      String?       @map("customer_phone")
  checkInDate        DateTime      @map("check_in_date") @db.Date
  checkOutDate       DateTime      @map("check_out_date") @db.Date
  nights             Int
  adults             Int           @default(1)
  children           Int           @default(0)
  baseAmount         Decimal       @map("base_amount") @db.Decimal(12, 2)
  taxesAmount        Decimal       @default(0) @map("taxes_amount") @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency           String        @default("GNF")
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  bookingStatus      BookingStatus @default(PENDING) @map("booking_status")
  specialRequest     String?       @map("special_request") @db.Text
  cancellationReason String?       @map("cancellation_reason") @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer  Customer   @relation(fields: [customerId], references: [id])
  room      Room       @relation(fields: [roomId], references: [id])
  payments  Payment[]
  invoices  Invoice[]
  documents Document[]

  @@index([roomId, bookingStatus, checkInDate, checkOutDate])
  @@index([customerEmail])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("bookings")
}

model Payment {
  id                  String            @id @default(cuid())
  bookingId           String            @map("booking_id")
  amount              Decimal           @db.Decimal(12, 2)
  currency            String            @default("GNF")
  paymentMethod       PaymentMethod     @map("payment_method")
  provider            String?
  providerPaymentId   String?           @map("provider_payment_id")
  transactionId       String?           @map("transaction_id")
  status              TransactionStatus @default(INITIATED)
  rawProviderResponse Json?             @map("raw_provider_response")
  paidAt              DateTime?         @map("paid_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  bookingId     String   @map("booking_id")
  invoiceNumber String   @unique @map("invoice_number")
  pdfUrl        String?  @map("pdf_url")
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("GNF")
  status        String   @default("GENERATED")
  createdAt     DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("invoices")
}

// Document commercial : devis (QUOTE) ou facture (INVOICE) avec lignes
// éditables. Peut être rattaché ou non à une réservation. Les informations
// client sont dénormalisées pour que le document reste figé/auto-suffisant.
model Document {
  id     String         @id @default(cuid())
  type   DocumentType
  number String         @unique // DEV-2026-0001 / FAC-2026-0001
  status DocumentStatus @default(DRAFT)

  // Client (figé sur le document)
  clientName    String  @map("client_name")
  clientEmail   String  @map("client_email")
  clientPhone   String? @map("client_phone")
  clientAddress String? @map("client_address")

  // Rattachements optionnels
  bookingId String? @map("booking_id")

  // Conversion devis -> facture (relation 1-1 auto-référencée)
  sourceQuoteId String? @unique @map("source_quote_id")

  // Montants (calculés à partir des lignes côté service)
  currency       String  @default("GNF")
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  // Dates : émission, et échéance (validité du devis / date limite de paiement)
  issueDate DateTime  @default(now()) @map("issue_date")
  dueDate   DateTime? @map("due_date")

  notes       String? @db.Text
  // Jeton d'accès public (lien sécurisé non devinable) pour consultation/PDF
  publicToken String  @unique @map("public_token")

  sentAt DateTime? @map("sent_at")
  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sourceQuote      Document?      @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  convertedInvoice Document?      @relation("QuoteToInvoice")
  lines            DocumentLine[]

  @@index([type, status])
  @@index([clientEmail])
  @@index([bookingId])
  @@index([createdAt])
  @@map("documents")
}

model DocumentLine {
  id          String  @id @default(cuid())
  documentId  String  @map("document_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_lines")
}

// Dépenses ponctuelles de l'hôtel (pas de récurrence). Le suivi alimente le
// tableau de bord : recettes − dépenses = bénéfice net.
model Expense {
  id        String          @id @default(cuid())
  reference String          @unique // DEP-2026-0001
  category  ExpenseCategory @default(OTHER)

  description String
  amount     Decimal @db.Decimal(12, 2)
  currency   String  @default("GNF")

  expenseDate DateTime @map("expense_date")

  vendor        String? // Fournisseur / bénéficiaire
  invoiceNumber String?              @map("invoice_number") // N° de facture du justificatif
  paymentMethod ExpensePaymentMethod @default(CASH) @map("payment_method")
  receiptUrl    String?              @map("receipt_url") // Lien vers le justificatif

  notes String? @db.Text

  // Auteur de la saisie (id utilisateur, sans FK pour rester souple).
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([expenseDate])
  @@index([createdAt])
  @@map("expenses")
}

model HotelService {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("hotel_services")
}

model Review {
  id           String   @id @default(cuid())
  customerName String   @map("customer_name")
  rating       Int
  comment      String?  @db.Text
  isApproved   Boolean  @default(false) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String        @map("full_name")
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("availability_blocks")
}

model PriceRule {
  id              String   @id @default(cuid())
  roomId          String   @map("room_id")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  pricePerNight   Decimal  @map("price_per_night") @db.Decimal(12, 2)
  minNights       Int?     @map("min_nights")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, isActive])
  @@map("price_rules")
}

model StaffMember {
  id         String          @id @default(cuid())
  fullName   String          @map("full_name")
  department StaffDepartment @default(HOUSEKEEPING)
  position   String?
  phone      String?
  email      String?
  isActive   Boolean         @default(true) @map("is_active")
  hireDate   DateTime?       @map("hire_date") @db.Date
  notes      String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  shifts StaffShift[]

  @@index([department])
  @@index([isActive])
  @@map("staff_members")
}

model StaffShift {
  id        String      @id @default(cuid())
  staffId   String      @map("staff_id")
  date      DateTime    @db.Date
  startTime String      @map("start_time")
  endTime   String      @map("end_time")
  area      String?
  status    ShiftStatus @default(SCHEDULED)
  notes     String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([staffId, date])
  @@map("staff_shifts")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscribers")
}
